generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @db.Uuid
  username  String   @unique
  email     String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())

  watchEntries WatchEntry[]

  @@map("users")
}

enum WatchType {
  ANIME
  SERIES
  FILM
}

enum WatchStatus {
  PLAN_TO_WATCH
  WATCHING
  COMPLETED
  ON_HOLD
  DROPPED
}

model WatchEntry {
  id              String      @id @default(uuid())
  userId          String      @db.Uuid
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  title           String
  type            WatchType
  posterUrl       String?
  totalEpisodes   Int?
  currentEpisode  Int         @default(0)
  totalSeasons    Int?
  currentSeason   Int?        @default(1)
  seasonsDetail   Json?
  status          WatchStatus
  rating          Float?
  notes           String?
  startedAt       DateTime?
  completedAt     DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId, status])
  @@index([userId, type])
  @@index([userId, rating])
  @@map("watch_entries")
}